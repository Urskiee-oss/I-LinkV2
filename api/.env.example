# ---- I-Link API (NestJS) ----
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ---- Supabase (server-side only — NEVER expose the service role key to the browser) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=report-attachments

# ---- I-Link AI (optional) ----
# Leave empty to run the built-in verified knowledge-base engine only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Demo seed / flood simulator ----
DEMO_PASSWORD=ILinkDemo2026!
# Device key printed by `npm run seed` for the demo flood sensor
FLOOD_DEVICE_KEY=
API_URL=http://localhost:4000/api
